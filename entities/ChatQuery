{
  "name": "ChatQuery",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "description": "The natural language question asked by the user"
    },
    "generated_sql": {
      "type": "string",
      "description": "The SQL query generated from the question"
    },
    "response_text": {
      "type": "string",
      "description": "The AI explanation response"
    },
    "visualization_type": {
      "type": "string",
      "enum": [
        "table",
        "bar_chart",
        "pie_chart",
        "line_chart",
        "metric"
      ],
      "description": "Type of visualization for the result"
    },
    "result_data": {
      "type": "string",
      "description": "JSON stringified result data"
    },
    "is_saved": {
      "type": "boolean",
      "description": "Whether the query is saved/bookmarked"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "error",
        "rejected"
      ],
      "description": "Status of the query"
    }
  },
  "required": [
    "question",
    "status"
  ]
}